# Keep text files LF across platforms; Windows batch files need CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.apk binary
*.aab binary
*.dex binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.pdf binary
